    {
      "name": "capture-line-item/requires-parent-order-and-amount",
      "description": "Per spec §5.5.6 a line-item capture MUST send REQUEST_REF_PO_ID and LI_VALUE_1 alongside REQUEST_REF_PO_LI_ID. Sending the line-item id alone is rejected with API 113 'Invalid Data' — verified against the live T1 gateway. The mocked corpus could not catch this because a mock accepts any request.",
      "request": {
        "operation": "captureLineItem",
        "orderRef": "PO-5000",
        "lineItemRef": "LI-1",
        "amount": {
          "amount": "1.00",
          "currency": "USD"
